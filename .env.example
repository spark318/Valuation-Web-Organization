# Copy to .env and fill in as needed. Everything is optional for local development:
# with nothing set, the app uses SQLite and stores uploads in ./media.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (used when DB_NAME is set)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# AWS S3 for uploaded PDFs (used when AWS_STORAGE_BUCKET_NAME is set)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-northeast-2
